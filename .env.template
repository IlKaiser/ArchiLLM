TEST_LLM_MODEL=anthropic/claude-sonnet-4-6
TEST_LLM_API_KEY=
SECONDARY_LLM_API_KEY=$(TEST_LLM_API_KEY)
LMNR_PROJECT_API_KEY=
OPENHANDS_API_KEY=
# Primary LLM for diagram generation (any LiteLLM-compatible "provider/model" string).
# LLM_API_KEY must match whichever provider LLM_MODEL points at. Pricing below is
# litellm's own bundled rate card (litellm.model_cost, per 1M tokens) — check it
# directly if this drifts, rather than trusting this comment:
#   python -c "import litellm; print(litellm.model_cost['<model>'])"
#   deepseek/deepseek-flash           -> DeepSeek V4.1 Flash (current default; released
#                                        2026-09-10). $0.30 in / $1.20 out per 1M tokens
#                                        (cache-hit input $0.006/1M); off-peak discount
#                                        window applies automatically. src/deepseek_pricing.py
#                                        registers this rate as a fallback for older litellm
#                                        pins that predate DeepSeek V4.1 Flash — a no-op on
#                                        litellm >=1.9x, which already has this entry built in.
#                                        LLM_API_KEY = your DeepSeek API key, no LLM_BASE_URL needed.
#   moonshot/kimi-k2.7-code           -> Moonshot Kimi K2.7 Code. $0.95 in / $4.00 out per
#                                        1M tokens (cache-hit input $0.19/1M) — roughly 3x
#                                        DeepSeek-Flash's per-token cost either direction.
#                                        LLM_API_KEY = your Moonshot API key (this repo also
#                                        keeps that under MOONSHOT_API_KEY below).
#   moonshot/kimi-k2.5                -> Moonshot Kimi K2.5 (older/cheaper Kimi generation).
#                                        $0.60 in / $3.00 out per 1M tokens.
#   anthropic/claude-sonnet-4-5-...   -> Anthropic
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-flash

# Alternate actor-model credentials, kept separate from LLM_API_KEY so switching
# LLM_MODEL between providers doesn't require overwriting a working key.
MOONSHOT_API_KEY=

# LLM-as-a-judge (evaluation only) — OpenAI-compatible endpoint.
LLM_JUDGE_KEY=
LLM_JUDGE_URL=https://api.openai.com/v1
JUDGE_MODEL=gpt-5.6-luna

GITHUB_TOKEN=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_JUDGE_MODEL=deepseek-chat
